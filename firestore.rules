rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function viewerPhone() {
      return request.auth.token.phone_number;
    }

    function isActiveUser() {
      return request.auth != null
        && request.auth.token.phone_number is string
        && exists(/databases/$(database)/documents/whitelist_entries/$(viewerPhone()))
        && get(/databases/$(database)/documents/whitelist_entries/$(viewerPhone())).data.is_enabled == true;
    }

    function isActiveAdmin() {
      return isActiveUser()
        && request.auth.token.admin == true
        && get(/databases/$(database)/documents/whitelist_entries/$(viewerPhone())).data.is_admin == true;
    }

    match /users/{phoneNumber} {
      allow read: if isActiveAdmin()
        || (isActiveUser() && phoneNumber == viewerPhone());
      allow write: if false;
    }

    match /user_profiles/{phoneNumber} {
      allow read: if isActiveAdmin()
        || (isActiveUser() && phoneNumber == viewerPhone());
      allow write: if false;
    }

    match /food_analysis_logs/{logId} {
      allow read: if isActiveAdmin()
        || (
          isActiveUser()
          && resource.data.user_id == viewerPhone()
          && resource.data.status == "success"
        );
      allow create, update: if false;
      allow delete: if isActiveAdmin();
    }

    match /usage_events/{eventId} {
      allow read: if isActiveAdmin();
      allow write: if false;
    }

    match /app_settings/{documentId} {
      allow read: if isActiveAdmin();
      allow create, update: if isActiveAdmin() && documentId == "runtime";
      allow delete: if false;
    }

    // Pemegang kode acak dapat membaca tepat satu dokumen yang belum kedaluwarsa.
    // Listing dilarang; setelah login, hanya pemilik token yang boleh menghapus.
    match /admin_login_codes/{codeHash} {
      allow get: if resource.data.expires_at > request.time;
      allow list, create, update: if false;
      allow delete: if isActiveUser()
        && resource.data.phone_number == viewerPhone();
    }

    match /whitelist_entries/{phoneNumber} {
      allow read: if isActiveAdmin()
        || (isActiveUser() && phoneNumber == viewerPhone());

      allow create: if isActiveAdmin()
        && request.resource.data.phone_number == phoneNumber
        && request.resource.data.created_by_phone == viewerPhone()
        && request.resource.data.is_enabled == true;

      allow update: if isActiveAdmin()
        && request.resource.data.phone_number == resource.data.phone_number
        && request.resource.data.created_by_phone == resource.data.created_by_phone
        && request.resource.data.created_at == resource.data.created_at
        && (
          phoneNumber != viewerPhone()
          || (request.resource.data.is_admin == true && request.resource.data.is_enabled == true)
        );

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
